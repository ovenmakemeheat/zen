{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zen",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "html_handling": "force-trailing-slash" },
